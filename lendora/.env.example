# Base URL for the account-service contract documented in README.md.
# An empty value uses same-origin /api/v1. The dev server proxies /api to lendora-service on port 8086.
VITE_AUTH_API_URL=
# Workspace destinations are shown only after a successful account-service login.
VITE_LENDDESK_URL=http://localhost:5175
VITE_BORROWDESK_URL=http://localhost:5173
# Backend address used by the Vite dev proxy. Restart Vite after changing it.
LENDORA_PROXY_TARGET=http://127.0.0.1:8086
