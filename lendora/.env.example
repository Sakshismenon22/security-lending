# Base URL for the account-service contract documented in README.md.
# An empty value uses same-origin /api/v1. No authentication backend is included here.
VITE_AUTH_API_URL=
# Workspace destinations are shown only after a successful account-service login.
VITE_LENDDESK_URL=http://localhost:5175
VITE_BORROWDESK_URL=http://localhost:5173
